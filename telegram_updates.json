alse, "post id": "https://t.me/c/1748646263/1200426"}, {"title": "\u062a\u0648\u0627\u0641\u0642 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0648 \u0641\u06cc\u0648\u0631\u0646\u062a\u06cc\u0646\u0627 \u0628\u0631 \u0633\u0631 \u0627\u0646\u062a\u0642\u0627\u0644 \u0642\u0631\u0636\u06cc \u0631\u0627\u062f\u0648 \u062f\u0631\u0627\u06af\u0648\u0634\u06cc\u0646", "summary": "\u0645\u062f\u0627\u0641\u0639 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0628\u0627 \u0642\u0631\u0627\u0631\u062f\u0627\u062f\u06cc \u0642\u0631\u0636\u06cc \u0648 \u0628\u0646\u062f \u062e\u0631\u06cc\u062f \u0627\u062c\u0628\u0627\u0631\u06cc \u06f2\u06f1.\u06f4 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u067e\u0648\u0646\u062f\u06cc \u0628\u0647 \u0641\u06cc\u0648\u0631\u0646\u062a\u06cc\u0646\u0627 \u0645\u06cc\u200c\u067e\u06cc\u0648\u0646\u062f\u062f \u06a9\u0647 \u062f\u0631 \u0635\u0648\u0631\u062a \u062a\u06a9\u0631\u0627\u0631 \u062a\u0639\u062f\u0627\u062f \u0645\u0634\u062e\u0635\u06cc \u0627\u0632 \u0628\u0627\u0632\u06cc\u200c\u0647\u0627 \u0641\u0639\u0627\u0644 \u0645\u06cc\u200c\u0634\u0648\u062f.", "is similar": false, "post id": "https://t.me/c/1748646263/1200496"}, {"title": "\u062a\u0648\u0627\u0641\u0642 \u0641\u06cc\u0648\u0631\u0646\u062a\u06cc\u0646\u0627 \u0628\u0631\u0627\u06cc \u062c\u0630\u0628 \u0642\u0631\u0636\u06cc \u0631\u0627\u062f\u0648 \u062f\u0631\u0627\u06af\u0648\u0634\u06cc\u0646", "summary": "\u0641\u06cc\u0648\u0631\u0646\u062a\u06cc\u0646\u0627 \u0628\u0627 \u067e\u0631\u062f\u0627\u062e\u062a \u06f1.\u06f5 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u06cc\u0648\u0631\u0648 \u0628\u0647 \u0635\u0648\u0631\u062a \u0642\u0631\u0636\u06cc \u0648 \u06af\u0646\u062c\u0627\u0646\u062f\u0646 \u0628\u0646\u062f \u062e\u0631\u06cc\u062f \u06f1\u06f7.\u06f5 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u06cc\u0648\u0631\u0648\u06cc\u06cc\u060c \u062f\u0631 \u0622\u0633\u062a\u0627\u0646\u0647 \u0628\u0647 \u062e\u062f\u0645\u062a \u06af\u0631\u0641\u062a\u0646 \u062f\u0631\u06