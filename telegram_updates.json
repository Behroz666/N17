06cc\u0646\u06af\u0647\u0627\u0645 \u0641\u0627\u0631\u0633\u062a \u0642\u0631\u0627\u0631 \u062f\u0627\u0631\u062f\u060c \u0645\u062e\u0627\u0644\u0641\u062a \u06a9\u0631\u062f.", "post id": "https://t.me/c/1748646263/1199642"}, {"title": "\u0635\u0639\u0648\u062f \u0627\u0633\u067e\u0627\u0646\u06cc\u0627 \u0628\u0647 \u0645\u0631\u062d\u0644\u0647 \u06cc\u06a9\u200c\u0647\u0634\u062a\u0645 \u0646\u0647\u0627\u06cc\u06cc \u062c\u0627\u0645 \u062c\u0647\u0627\u0646\u06cc \u06f2\u06f0\u06f2\u06f6 \u0628\u0627 \u062f\u0631\u062e\u0634\u0634 \u067e\u062f\u0631\u0648 \u067e\u0648\u0631\u0648", "summary": "\u0627\u0633\u067e\u0627\u0646\u06cc\u0627 \u0628\u0627 \u067e\u06cc\u0631\u0648\u0632\u06cc \u06f3 \u0628\u0631 \u0635\u0641\u0631 \u0645\u0642\u0627\u0628\u0644 \u0627\u062a\u0631\u06cc\u0634 \u0648 \u062b\u0628\u062a \u0627\u0648\u0644\u06cc\u0646 \u06af\u0644 \u0645\u0644\u06cc \u0648 \u0627\u0648\u0644\u06cc\u0646 \u06af\u0644 \u062c\u0627\u0645 \u062c\u0647\u0627\u0646\u06cc \u067e\u062f\u0631\u0648 \u067e\u0648\u0631\u0648\u060c \u0628\u0647 \u0645\u0631\u062d\u0644\u0647 \u06cc\u06a9\u200c\u0647\u0634\u062a\u0645 \u0646\u0647\u0627\u06cc\u06cc \u062c\u0627\u0645 \u062c\u0647\u0627\u0646\u06cc \u06f2\u06f0\u06f2\u06f6 \u0635\u0639\u0648\u062f \u06a9\u0631\u062f.", "post id": "https://t.me/c/1748646263/1199797"}, {"title": "\u062d\u0630\u0641 \u0627\u062a\u0631\u06cc\u0634 \u0648 \u06a9\u0648\u06cc\u0646 \u062f\u0627\u0646\u0633\u0648 \u0627\u0632 \u062c\u0627\u0645 \u062c\u0647\u0627\u0646\u06cc", "summary": "\u062a\u06cc\u0645 \u0645\u0644\u06cc \u0627\u062a\u0631\u06cc\u0634 \u0628\u0627 \u0634\u06a9\u0633\u062a \u06f3 \u0628\u0631 \u0635\u0641\u0631 \u0645\u0642\u0627\u0628\u0644 \u0627\u0633\u067e\u0627\u0646\u06cc\u0627 \u062f\u0631 \u0645\u0631\u062d\u0644\u0647 \u06cc\u06a9\u200c\u0634\u0627\u0646\u0632\u062f\u0647\u0645 \u0646\u0647\u0627\u06cc\u06cc \u0627\u0632 \u0631\u0642\u0627\u0628\u062a\u200c\u0647\u0627\u06cc \u062c\u0627\u0645 \u062c\u0647\u0627\u0646\u06cc \u06a9\u0646\u0627\u0631 \u0631\u0641\u062a.", "post id": "https://t.me/c/1748646263/1199799"}, {"title": "\u0645\u0627\u062a\u0626\u0648\u0633 \u0641\u0631\u0646\u0627\u0646\u062f\u0632: \u0628\u0631\u0627\u06cc \u0645\u0648\u0641\u0642\u06cc\u062a \u0628\u0627 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0622\u0645\u0627\u062f\u0647\u200c\u0627\u0645", "summary": "\u0645\u0627\u062a\u0626\u0648\u0633 \u0641\u0631\u0646\u0627\u0646\u062f\u0632 \u0636\u0645\u0646 \u0627\u0628\u0631\u0627\u0632 \u062e\u0648\u0634\u062d\u0627\u0644\u06cc \u0627\u0632 \u067e\u06cc\u0648\u0633\u062a\u0646 \u0628\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645\u060c \u062a\u0623\u06a9\u06cc\u062f \u06a9\u0631\u062f \u06a9\u0647 \u0628\u0627 \u0630\u0647\u0646\u06cc\u062a\u06cc \u0642\u0648\u06cc\u200c\u062a\u0631 \u0648 \u0622\u0645\u0627\u062f\u06af\u06cc \u06a9\u0627\u0645\u0644 \u0628\u0631\u0627\u06cc \u06a9\u0645\u06a9 \u0628\u0647 \u0627\u06cc\u0646 \u0628\u0627\u0634\u06af\u0627\u0647 \u062f\u0631 \u0631\u0627\u0647 \u06a9\u0633\u0628 \u0639\u0646\u0627\u0648\u06cc\u0646 \u0642\u0647\u0631\u0645\u0627\u0646\u06cc \u062a\u062d\u062a \u0647\u062f\u0627\u06cc\u062a \u0633\u0631\u0645\u0631\u0628\u06cc \u062c\u062f\u06cc\u062f \u0628\u0647 \u0627\u06cc\u0646 \u062a\u06cc\u0645 \u0645\u0644\u062d\u0642 \u0634\u062f\u0647 \u0627\u0633\u062a.", "post id": "https://t.me/c/1748646263/1199802"}, {"title": "\u0627\u0639\u0644\u0627\u0645 \u0632\u0645\u0627\u0646 \u0627\u0646\u062a\u0634\u0627\u0631 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0627\u0632\u06cc\u200c\u0647\u0627\u06cc \u0641\u0635\u0644 \u06f2\u06f0\u06f2\u06f6/\u06f2\u06f7 \u062a\u06cc\u0645 \u0632\u0646\u0627\u0646 \u062a\u0627\u062a\u0646\u0647\u0627\u0645", "summary": "\u0628\u0631\u0646\u0627\u0645\u0647 \u0645\u0633\u0627\u0628\u0642\u0627\u062a \u0641\u0635\u0644 \u06f2\u06f0\u06f2\u06f6/\u06f2\u06f7 \u0644\u06cc\u06af \u0628\u0631\u062a\u0631 \u0632\u0646\u0627\u0646 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u062f\u0631 \u062a\u0627\u0631\u06cc\u062e \u06f3\u06f0 \u062c\u0648\u0644\u0627\u06cc \u0645\u0646\u062a\u0634\u0631 \u062e\u0648\u0627\u0647\u062f \u0634\u062f \u0648 \u062a\u0639\u062f\u0627\u062f \u0628\u0627\u0632\u06cc\u200c\u0647\u0627 \u0628\u0647 \u062f\u0644\u06cc\u0644 \u06af\u0633\u062a\u0631\u0634 \u0644\u06cc\u06af \u0628\u0647 \u06f1\u06f4 \u062a\u06cc\u0645\u060c \u0628\u0647 \u06f2\u06f6 \u0645\u0633\u0627\u0628\u0642\u0647 \u0627\u0641\u0632\u0627\u06cc\u0634 \u06cc\u0627\u0641\u062a\u0647 \u0627\u0633\u062a.", "post id": "https://t.me/c/1748646263/1199804"}, {"title": "\u0645\u0634\u0648\u0631\u062a \u0645\u0627\u062a\u0626\u0648\u0633 \u0641\u0631\u0646\u0627\u0646\u062f\u0632 \u0628\u0627 \u067e\u062f\u0631\u0648 \u067e\u0648\u0631\u0648 \u067e\u06cc\u0634 \u0627\u0632 \u0627\u0646\u062a\u0642\u0627\u0644 \u0628\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645", "summary": "\u0645\u0627\u062a\u0626\u0648\u0633 \u0641\u0631\u0646\u0627\u0646\u062f\u0632 \u067e\u06cc\u0634 \u0627\u0632 \u067e\u06cc\u0648\u0633\u062a\u0646 \u0628\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645\u060c \u0628\u0627 \u0647\u0645\u200c\u062a\u06cc\u0645\u06cc \u0633\u0627\u0628\u0642\u0634 \u067e\u062f\u0631\u0648 \u067e\u0648\u0631\u0648 \u0645\u0634\u0648\u0631\u062a \u06a9\u0631\u062f\u0647 \u0648 \u0627\u0632 \u0622\u0645\u0627\u062f\u06af\u06cc \u062e\u0648\u062f \u0628\u0631\u0627\u06cc \u0631\u0642\u0627\u0628\u062a \u0628\u0631 \u0633\u0631 \u0642\u0647\u0631\u0645\u0627\u0646\u06cc \u062e\u0628\u0631 \u062f\u0627\u062f\u0647 \u0627\u0633\u062a.", "post id": "https://t.me/c/1748646263/1199806"}, {"title": "\u0645\u0627\u062a\u0626\u0648\u0633 \u0641\u0631\u0646\u0627\u0646\u062f\u0632: \u0631\u0648\u0628\u0631\u062a\u0648 \u062f\u0632\u0631\u0628\u06cc \u0639\u0627\u0645\u0644 \u0627\u0635\u0644\u06cc \u067e\u06cc\u0648\u0633\u062a\u0646 \u0645\u0646 \u0628\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0628\u0648\u062f", "summary": "\u0645\u0627\u062a\u0626\u0648\u0633 \u0641\u0631\u0646\u0627\u0646\u062f\u0632\u060c \u0628\u0627\u0632\u06cc\u06a9\u0646 \u062c\u062f\u06cc\u062f \u062a\u0627\u062a\u0646\u0647\u0627\u0645\u060c \u0646\u0642\u0634 \u0631\u0648\u0628\u0631\u062a\u0648 \u062f\u0632\u0631\u0628\u06cc \u062f\u0631 \u0645\u062a\u0642\u0627\u0639\u062f \u06a9\u0631\u062f\u0646 \u0627\u0648 \u0628\u0631\u0627\u06cc \u067e\u06cc\u0648\u0633\u062a\u0646 \u0628\u0647 \u0627\u06cc\u0646 \u0628\u0627\u0634\u06af\u0627\u0647 \u0631\u0627 \u06a9\u0644\u06cc\u062f\u06cc \u062e\u0648\u0627\u0646\u062f \u0648 \u0627\u0632 \u0627\u0634\u062a\u06cc\u0627\u0642 \u062e\u0648\u062f \u0628\u0631\u0627\u06cc \u0686\u0627\u0644\u0634\u200c\u0647\u0627\u06cc \u067e\u06cc\u0634 \u0631\u0648 \u06af\u0641\u062a.", "post id": "https://t.me/c/1748646263/1199808"}, {"title": "\u0639\u062f\u0645 \u0628\u0627\u0632\u06af\u0634\u062a \u0698\u0627\u0626\u0648 \u067e\u0627\u0644\u06cc\u0646\u06cc\u0627 \u0628\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645", "summary": "\u0628\u0647 \u06af\u0641\u062a\u0647 \u062a\u0627\u0645 \u0628\u0627\u0631\u06a9\u0644\u06cc \u0627\u0632 \u0646\u0634\u0631\u06cc\u0647 \u0633\u0627\u0646\u060c \u0628\u0627 \u062c\u0630\u0628 \u062e\u0631\u06cc\u062f\u0647\u0627\u06cc \u0628\u0632\u0631\u06af \u062f\u0631 \u062e\u0637 \u0645\u06cc\u0627\u0646\u06cc\u060c \u067e\u06cc\u0648\u0633\u062a\u0646 \u0698\u0627\u0626\u0648 \u067e\u0627\u0644\u06cc\u0646\u06cc\u0627 \u0628\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0645\u0646\u062a\u0641\u06cc \u0627\u0633\u062a.", "post id": "https://t.me/c/1748646263/1199810"}, {"title": "\u0627\u0638\u0647\u0627\u0631\u0627\u062a \u0645\u0627\u062a\u0626\u0648\u0633 \u0641\u0631\u0646\u0627\u0646\u062f\u0632 \u062f\u0631\u0628\u0627\u0631\u0647 \u0642\u0647\u0631\u0645\u0627\u0646\u06cc \u062f\u0631 \u0644\u06cc\u06af \u0628\u0631\u062a\u0631", "summary": "\u0645\u0627\u062a\u0626\u0648\u0633 \u0641\u0631\u0646\u0627\u0646\u062f\u0632 \u0628\u0631 \u0639\u0632\u0645 \u062a\u06cc\u0645 \u062e\u0648\u062f \u0628\u0631\u0627\u06cc \u062a\u0644\u0627\u0634 \u062c\u0647\u062a \u06a9\u0633\u0628 \u0642\u0647\u0631\u0645\u0627\u0646\u06cc \u0648 \u062c\u0627\u06cc\u06af\u0627\u0647 \u0646\u062e\u0633\u062a \u0644\u06cc\u06af \u0628\u0631\u062a\u0631 \u062a\u0623\u06a9\u06cc\u062f \u06a9\u0631\u062f.", "post id": "https://t.me/c/1748646263/1199812"}, {"title": "\u062e\u0644\u0627\u0635\u0647\u200c\u0627\u06cc \u0627\u0632 \u0648\u0642\u0627\u06cc\u0639 \u0698\u0648\u0626\u0646 \u06f2\u06f0\u06f2\u06f6", "summary": "\u067e\u06cc\u0627\u0645\u06cc \u0628\u0631\u0627\u06cc \u0642\u062f\u0631\u062f\u0627\u0646\u06cc \u0627\u0632 \u0647\u0645\u0631\u0627\u0647\u06cc \u0645\u062e\u0627\u0637\u0628\u0627\u0646 \u062f\u0631 \u0645\u0627\u0647 \u067e\u0631\u06a9\u0627\u0631 \u0698\u0648\u0626\u0646 \u06f2\u06f0\u06f2\u06f6.", "post id": "https://t.me/c/1748646263/1199814"}, {"title": "\u0634\u0645\u0627\u0631\u0634 \u0645\u0639\u06a9\u0648\u0633 \u0628\u0631\u0627\u06cc \u0622\u063a\u0627\u0632 \u0641\u0635\u0644 \u062c\u062f\u06cc\u062f \u062a\u0627\u062a\u0646\u0647\u0627\u0645", "summary": "\u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u06f5\u06f0 \u0631\u0648\u0632 \u062f\u06cc\u06af\u0631 \u0641\u0635\u0644 \u062c\u062f\u06cc\u062f \u0631\u0627 \u0645\u0642\u0627\u0628\u0644 \u0628\u0631\u0646\u062a\u0641\u0648\u0631\u062f \u0622\u063a\u0627\u0632 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u06f6\u06f1 \u0631\u0648\u0632 \u062a\u0627 \u067e\u0627\u06cc\u0627\u0646 \u0646\u0642\u0644 \u0648 \u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a \u062a\u0627\u0628\u0633\u062a\u0627\u0646\u06cc \u0628\u0627\u0642\u06cc \u0627\u0633\u062a.", "post id": "https://t.me/c/1748646263/1199862"}, {"title": "\u0627\u062f\u0627\u0645\u0647 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u062f\u0631 \u0644\u06cc\u0633\u062a \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u062f\u0631 \u062a\u0627\u0628\u0633\u062a\u0627\u0646 \u062c\u0627\u0631\u06cc", "summary": "\u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0628\u0647 \u0645\u0646\u0638\u0648\u0631 \u062a\u0623\u0645\u06cc\u0646 \u0628\u0648\u062f\u062c\u0647 \u0628\u0631\u0627\u06cc \u062a\u0642\u0648\u06cc\u062a \u062e\u0637 \u062d\u0645\u0644\u0647 \u0648 \u0633\u0627\u06cc\u0631 \u0646\u0642\u0627\u0637 \u0636\u0639\u0641 \u062a\u06cc\u0645\u060c \u0628\u0647 \u062f\u0646\u0628\u0627\u0644 \u0641\u0631\u0648\u0634 \u0628\u0627\u0632\u06cc\u06a9\u0646\u0627\u0646 \u0628\u06cc\u0634\u062a\u0631\u06cc \u062f\u0631 \u062a\u0627\u0628\u0633\u062a\u0627\u0646 \u0627\u0633\u062a.", "post id": "https://t.me/c/1748646263/1199864"}, {"title": "\u062d\u0630\u0641 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0627\u06cc\u0646\u0633\u062a\u0627\u06af\u0631\u0627\u0645 \u067e\u0627\u067e \u0645\u0627\u062a\u0627\u0631 \u0633\u0627\u0631 \u067e\u0633 \u0627\u0632 \u062d\u0630\u0641 \u0633\u0646\u06af\u0627\u0644 \u0627\u0632 \u062c\u0627\u0645 \u062c\u0647\u0627\u0646\u06cc", "summary": "\u067e\u0627\u067e \u0645\u0627\u062a\u0627\u0631 \u0633\u0627\u0631 \u062f\u0631 \u067e\u06cc \u062d\u0630\u0641 \u062a\u06cc\u0645 \u0645\u0644\u06cc \u0633\u0646\u06af\u0627\u0644 \u0627\u0632 \u0645\u0633\u0627\u0628\u0642\u0627\u062a \u062c\u0627\u0645 \u062c\u0647\u0627\u0646\u06cc\u060c \u062d\u0633\u0627\u0628 \u0627\u06cc\u0646\u0633\u062a\u0627\u06af\u0631\u0627\u0645 \u062e\u0648\u062f \u0631\u0627 \u0628\u0633\u062a.", "post id": "https://t.me/c/1748646263/1199866"}, {"title": "\u0627\u0638\u0647\u0627\u0631\u0627\u062a \u0644\u0648\u06a9\u0627\u0633 \u0628\u0631\u06af\u0648\u0627\u0644 \u067e\u06cc\u0631\u0627\u0645\u0648\u0646 \u0622\u06cc\u0646\u062f\u0647 \u062e\u0648\u062f \u062f\u0631 \u062a\u0627\u062a\u0646\u0647\u0627\u0645", "summary": "\u0644\u0648\u06a9\u0627\u0633 \u0628\u0631\u06af\u0648\u0627\u0644 \u0628\u0631 \u062a\u0645\u0627\u06cc\u0644 \u062e\u0648\u062f \u0628\u0631\u0627\u06cc \u062d\u0636\u0648\u0631 \u0645\u062f\u0627\u0648\u0645 \u062f\u0631 \u062a\u0631\u06a9\u06cc\u0628 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0648 \u062a\u0645\u0631\u06a9\u0632 \u0628\u0631 \u0627\u0647\u062f\u0627\u0641 \u062d\u0631\u0641\u0647\u200c\u0627\u06cc \u062a\u0623\u06a9\u06cc\u062f \u06a9\u0631\u062f.", "post id": "https://t.me/c/1748646263/1199868"}, {"title": "\u0639\u0644\u0627\u0642\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0628\u0647 \u062c\u0630\u0628 \u06a9\u0648\u062f\u06cc \u06af\u0627\u06a9\u067e\u0648", "summary": "\u0641\u0627\u0628\u0631\u06cc\u0632\u06cc\u0648 \u0631\u0648\u0645\u0627\u0646\u0648 \u0627\u0632 \u0639\u0644\u0627\u0642\u0647 \u0628\u0627\u0634\u06af\u0627\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0628\u0647 \u06a9\u0648\u062f\u06cc \u06af\u0627\u06a9\u067e\u0648 \u062f\u0631 \u067e\u0646\u062c\u0631\u0647 \u0646\u0642\u0644 \u0648 \u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a \u062a\u0627\u0628\u0633\u062a\u0627\u0646\u06cc \u062e\u0628\u0631 \u062f\u0627\u062f.", "post id": "https://t.me/c/1748646263/1199870"}, {"title": "\u0639\u0644\u0627\u0642\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0628\u0647 \u062c\u0630\u0628 \u0627\u0644\u06cc \u062c\u0648\u0646\u06cc\u0648\u0631 \u06a9\u0631\u0648\u067e\u06cc \u0627\u0632 \u0628\u0648\u0631\u0646\u0645\u0648\u062b", "summary": "\u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0628\u0647 \u0627\u0644\u06cc \u062c\u0648\u0646\u06cc\u0648\u0631 \u06a9\u0631\u0648\u067e\u06cc \u0639\u0644\u0627\u0642\u0647\u200c\u0645\u0646\u062f \u0627\u0633\u062a \u0627\u0645\u0627 \u0628\u0647 \u062f\u0644\u06cc\u0644 \u0639\u062f\u0645 \u0646\u06cc\u0627\u0632 \u0645\u0627\u0644\u06cc \u0628\u0648\u0631\u0646\u0645\u0648\u062b \u0648 \u062e\u0648\u0627\u0633\u062a\u0647 \u0627\u06cc\u0646 \u0628\u0627\u0634\u06af\u0627\u0647 \u0628\u0631\u0627\u06cc \u062d\u0641\u0638 \u0628\u0627\u0632\u06cc\u06a9\u0646\u0627\u0646\u060c \u0627\u0646\u062a\u0642\u0627\u0644 \u0627\u0648 \u0628\u0633\u06cc\u0627\u0631 \u0628\u0639\u06cc\u062f \u0627\u0633\u062a.", "post id": "https://t.me/c/1748646263/1199902"}, {"title": "\u062e\u062f\u0627\u062d\u0627\u0641\u0638\u06cc \u0698\u0648\u0627\u0626\u0648 \u067e\u0627\u0644\u06cc\u0646\u06cc\u0627 \u0628\u0627 \u0628\u0627\u0634\u06af\u0627\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645", "summary": "\u0698\u0648\u0627\u0626\u0648 \u067e\u0627\u0644\u06cc\u0646\u06cc\u0627 \u0628\u0627 \u0627\u0646\u062a\u0634\u0627\u0631 \u067e\u06cc\u0627\u0645\u06cc \u0627\u062d\u0633\u0627\u0633\u06cc \u0627\u0632 \u0647\u0648\u0627\u062f\u0627\u0631\u0627\u0646\u060c \u0647\u0645\u200c\u062a\u06cc\u0645\u06cc\u200c\u0647\u0627 \u0648 \u06a9\u0627\u0631\u06a9\u0646\u0627\u0646 \u0628\u0627\u0634\u06af\u0627\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u062f\u0631 \u0632\u0645\u0627\u0646 \u062a\u0631\u06a9 \u0627\u06cc\u0646 \u062a\u06cc\u0645 \u062a\u0634\u06a9\u0631 \u0648 \u0642\u062f\u0631\u062f\u0627\u0646\u06cc \u06a9\u0631\u062f.", "post id": "https://t.me/c/1748646263/1199905"}, {"title": "\u0622\u062e\u0631\u06cc\u0646 \u0648\u0636\u0639\u06cc\u062a \u0639\u0644\u0627\u0642\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0628\u0647 \u06a9\u0648\u062f\u06cc \u06af\u0627\u06a9\u067e\u0648 \u0627\u0632 \u0646\u06af\u0627\u0647 \u0641\u0627\u0628\u0631\u06cc\u062a\u0632\u06cc\u0648 \u0631\u0648\u0645\u0627\u0646\u0648", "summary": "\u0628\u0647 \u06af\u0641\u062a\u0647 \u0641\u0627\u0628\u0631\u06cc\u062a\u0632\u06cc\u0648 \u0631\u0648\u0645\u0627\u0646\u0648\u060c \u062a\u0627\u062a\u0646\u0647\u0627\u0645 \u0628\u0647 \u062c\u0630\u0628 \u06a9\u0648\u062f\u06cc \u06af\u0627\u06a9\u067e\u0648 \u0639\u0644\u0627\u0642\u0647\u200c\u0645\u0646\u062f \u0627\u0633\u062a\u060c \u0627\u0645\u0627 \u0644\u06cc\u0648\u0631\u067e\u0648\u0644 \u062f\u0631 \u062d\u0627\u0644 \u062d\u0627\u0636\u0631 \u062a\u0645\u0627\u06cc\u0644\u06cc \u0628\u0647 \u0641\u0631\u0648\u0634 \u0627\u06cc\u0646 \u0628\u0627\u0632\u06cc\u06a9\u0646 \u0646\u062f\u0627\u0631\u062f \u0648 \u0647\u06cc\u0686 \u0645\u0630\u0627\u06a9\u0631\u0647 \u0631\u0633\u0645\u06cc \u0635\u0648\u0631\u062a \u0646\u06af\u0631\u0641\u062a\u0647 \u0627\u0633\u062a.", "post id": "https://t.me/c/1748646263/1199907"}, {"title": "\u0627\u0646\u062a\u0642\u0627\u062f \u0634\u062f\u06cc\u062f \u0633\u0627\u06cc\u0645\u0648\u0646 \u062c\u0631\u062f\u0646 \u0627\u0632 \u0633\u06cc\u0627\u0633\u062a\u200c\u0647\u0627\u06cc \u0646\u0642\u0644 \u0648 \u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a\u06cc \u0648 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0628\u0627\u0634\u06af\u0627\u0647 \u062a\u0627\u062a\u0646\u0647\u0627\u0645", "summary": "\u0633\u0627\u06cc\u0645\u0648\u0646 \u062c\u0631\u062f\u0646\u060c \u06a9\u0627\u0631\u0634\u0646\u0627\u0633 \u062a\u0627\u06a9\u200c\u0627\u0633\u067e\u0648\u0631\u062a\u060c \u0628\u0627 \u0627\u0646\u062a\u0642\u0627\u062f \u0627\u0632 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0648 \u0633\u06cc\u0627\u0633\u062a\u200c\u0647\u0627\u06cc \u0647\u0632\u06cc\u0646\u0647\u200c\u06a9\u0631\u062f \u062a\u0627\u062a\u0646\u0647\u0627\u0645\u060c \u062e\u0631\u06cc\u062f\u0647\u0627\u06cc \u06af\u0631\u0627\u0646\u200c\u0642\u06cc\u0645\u062a \u0627\u062e\u06cc\u0631 \u0627\u06cc\u0646 \u0628\u0627\u0634\u06af\u0627\u0647 \u0631\u0627 \u0646\u0627\u0634\u06cc \u0627\u0632 \u0641\u0642\u062f\u0627\u0646 \u062a\u062e\u0635\u0635 \u0641\u0648\u062a\u0628\u0627\u0644\u06cc \u0648 \u0631\u0641\u062a\u0627\u0631\u0647\u0627\u06cc \u0622\u0634\u0641\u062a\u0647 \u0645\u062f\u06cc\u0631\u06cc\u062a\u06cc \u062f\u0627\u0646\u0633\u062a\u0647 \u0648 \u0646\u0633\u0628\u062a \u0628\u0647 \u0646\u062a\u0627\u06cc\u062c \u0622\u0646 \u0627\u0628\u0631\u0627\u0632 \u062a\u0631\u062f\u06cc\u062f \u06a9\u0631\u062f.", "post id": "https://t.me/c/1748646263/1199910"}, {"title": "\u0639\u062f\u0645 \u0627\u0645\u0636\u0627\u06cc \u0642\u0631\u0627\u0631\u062f\u0627\u062f \u062f\u0627\u0626\u0645\u06cc \u0698\u0627\u0626\u0648 \u067e\u0627\u0644\u06cc\u0646\u06cc\u0627 \u0628\u0627 \u062a\u0627\u062a\u0646\u0647\u0627\u0645", "summary": "\u0698\u0627\u0626\u0648 \u067e\u0627\u0644\u06cc\u0646\u06cc\u0627 \u067e\u0633 \u0627\u0632 \u0627\u062a\u0645\u0627\u0645 \u062f\u0648\u0631\u0647 \u0642\u0631\u0636\u06cc \u062e\u0648\u062f \u062f\u0631 \u062a\u0627\u062a\u0646\u0647\u0627\u0645\u060c \u0628\u0647 \u0627\u06cc\u0646 \u0628\u0627\u0634\u06af\u0627\u0647 \u0646\u062e\u0648\u0627\u0647\u062f \u067e\u06cc\u0648\u0633\u062a \u0648 \u0627\u062d\u062a\u0645\u0627\u0644 \u0628\u0627\u0632\u06af\u0634\u062a \u0627\u0648 \u0628\u0647 \u0627\u0633\u067e\u0648\u0631\u062a\u06cc\u0646\u06af \u067e\u0631\u062a\u063a\u0627\u0644 \u0627\u0641\u0632\u0627\u06cc\u0634 \u06cc\u0627\u0641\u062a\u0647 \u0627\u0633\u062a.", "post id": "https://t.me/c/1748646263/1199936"}, {"title": "\u0627\u0646\u062a\u0635\u0627\u0628 \u0622\u0646\u06af\u0647 \u067e\u0648\u0633\u062a\u06a9\u0648\u06af\u0644\u0648 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u0633\u0631\u0645\u0631\u0628\u06cc \u062c\u062f\u06cc\u062f \u062a\u06cc\u0645 \u0641\u0648\u062a\u0628\u0627\u0644 \u0627\u0644\u0646\u0635\u0631", "summary": "\u0622\u0646\u06af\u0647 \u067e\u0648\u0633\u062a\u06a9\u0648\u06af\u0644\u0648 \u0628\u0627 \u0627\u0645\u0636\u0627\u06cc \u0642\u0631\u0627\u0631\u062f\u0627\u062f\u06cc \u062f\u0648 \u0633\u0627\u0644\u0647 \u0647\u062f\u0627\u06cc\u062a \u062a\u06cc\u0645 \u0627\u0644\u0646\u0635\u0631 \u0639\u0631\u0628\u0633\u062a\u0627\u0646 \u0631\u0627 \u0628\u0631 \u0639\u0647\u062f\u0647 \u06af\u0631\u0641\u062a.", "post id": "https://t.me/c/1748646263/1199968"}, {"title": "\u0639\u0644\u0627\u0642\u0647 \u0641\u0646\u0631\u0628\u0627\u063a\u0686\u0647 \u0628\u0647 \u062c\u0630\u0628 \u0631\u06cc\u0686\u0627\u0631\u0644\u06cc\u0633\u0648\u0646", "summary": "\u0628\u0627\u0634\u06af\u0627\u0647 \u0641\u0646\u0631\u0628\u0627\u063a\u0686\u0647 \u0642\u0635\u062f \u062f\u0627\u0631\u062f \u0628\u0631\u0627\u06cc \u0628\u0647 \u062e\u062f\u0645\u062a \u06af\u0631\u0641\u062